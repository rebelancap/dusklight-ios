 namespace dusk::interp {
 
+// visionOS stereo 3D: export the main camera's eye->look-at distance so aurora can
+// set the convergence plane (STEREO-3D-RECOVERY-FABLE §4.1). 0 => not yet known.
+extern "C" volatile float gDusk3DCamDist = 0.0f;
+// Subject-anchored convergence (NEAR-DOUBLING-ANSWER-FABLE): eye->Link distance. TP's field
+// camera looks at the HORIZON, so eye->look-at puts the zero plane miles out and the whole
+// near field (ground, flowers, butterflies) is crossed-biased -> unfixable near doubling.
+// The zero plane belongs on the subject (Link); aurora prefers this, falling back to a
+// capped look-at for player-less frames (cutscenes/menus). 0 => Link not known this frame.
+extern "C" volatile float gDusk3DCamDistLink = 0.0f; // = eye->getPlayer(0)->current.pos (candidate P0cur)
+// NEAR-DOUBLING readout probe (STEP-AND-SHADOWS-ANSWER §A): the P0cur candidate above came back
+// garbage, so log ALL FOUR candidates and pick the ONE correct camera-eye->Link expression by
+// data. p0 = getPlayer(0), pL = getLinkPlayer (LINK_PTR slot); current.pos (feet) vs eyePos (head).
+extern "C" volatile float gDusk3DLinkP0Eye = 0.0f;
+extern "C" volatile float gDusk3DLinkPLCur = 0.0f;
+extern "C" volatile float gDusk3DLinkPLEye = 0.0f;
+
 void record_camera(::camera_process_class* cam, int camera_id) {
+    if (camera_id == 0 && cam != nullptr) {
+        const auto& e = cam->view.lookat.eye;
+        const auto& c = cam->view.lookat.center;
+        const float dx = e.x - c.x, dy = e.y - c.y, dz = e.z - c.z;
+        gDusk3DCamDist = std::sqrt(dx * dx + dy * dy + dz * dz);
+        auto distFrom = [&](const cXyz& q) {
+            const float lx = e.x - q.x, ly = e.y - q.y, lz = e.z - q.z;
+            return std::sqrt(lx * lx + ly * ly + lz * lz);
+        };
+        daPy_py_c* p0 = daPy_getPlayerActorClass();
+        daPy_py_c* pL = daPy_getLinkPlayerActorClass();
+        gDusk3DCamDistLink = (p0 != nullptr) ? distFrom(p0->current.pos) : 0.0f;
+        gDusk3DLinkP0Eye = (p0 != nullptr) ? distFrom(p0->eyePos) : 0.0f;
+        gDusk3DLinkPLCur = (pL != nullptr) ? distFrom(pL->current.pos) : 0.0f;
+        gDusk3DLinkPLEye = (pL != nullptr) ? distFrom(pL->eyePos) : 0.0f;
+    }
     if (!is_enabled() || camera_id != 0 || cam == nullptr) {
         return;
     }
