+#if defined(__APPLE__) && TARGET_OS_VISION
+uint64_t current_phys_footprint_mib() noexcept {
+  task_vm_info_data_t info{};
+  mach_msg_type_number_t count = TASK_VM_INFO_COUNT;
+  if (task_info(mach_task_self(), TASK_VM_INFO, reinterpret_cast<task_info_t>(&info), &count) == KERN_SUCCESS) {
+    return static_cast<uint64_t>(info.phys_footprint) / (1024ull * 1024ull);
+  }
+  return 0;
+}
+// Bytes the process may still allocate before jetsam -- the actual headroom,
+// and the number that decides whether a pack fits (FABLE 4.3).
+uint64_t available_memory_mib() noexcept {
+  return static_cast<uint64_t>(os_proc_available_memory()) / (1024ull * 1024ull);
+}
+#endif
