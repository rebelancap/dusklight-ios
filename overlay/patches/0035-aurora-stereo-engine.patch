+// dusk stereo (TEXGEN-SPLIT-ANSWER §1): tag the JUST-WRITTEN texmtx slot with its
+// J3DTexMtxMode so the config snapshot can split view-projected chains (water shine,
+// takes the stereo txs shift) from world-projected ones (ground overlay, cloud shadows
+// -- glued). A 1-word XF write to scratch 0x5F8 ([0x500,0x5F0) is PT matrix data) that
+// RIDES THE FIFO adjacent to the load -- a plain global would desync: every matrix load
+// is just bytes in the stream, drained ~5x/frame, with materials queued between drains.
+extern "C" void duskTagTexMtxClass(u32 gxMtxId, u32 cls) {
+  GX_WRITE_U8(0x10);
+  GX_WRITE_U32(0x5F8);
+  GX_WRITE_U32((gxMtxId << 8) | (cls & 0xFFu));
+}
