+// iOS/visionOS: the document picker returns the picked disc as a COPY in the
+// app's Inbox (<container>/tmp/<bundle-id>-Inbox/), which the OS purges between
+// launches -- so a stored Inbox path fails validation on the next launch and
+// Dusklight re-prompts for the disc every time (even after a crash + auto-
+// relaunch). Relocate the copy into the persistent data dir (Documents) and
+// return that stable path so the choice survives. Inbox and Documents share the
+// app-container volume, so the rename is instant regardless of the ~1.4 GB disc
+// size; a cross-volume fallback copies then unlinks the transient source.
+// Returns `path` unchanged on any failure or when it is already persistent
+// (non-Apple-mobile builds are a straight pass-through).
+std::string relocate_disc_to_persistent(const std::string& path) {
+#if defined(__APPLE__) && (TARGET_OS_IOS || TARGET_OS_VISION)
+    std::error_code ec;
+    const std::filesystem::path src{path};
+    const std::filesystem::path dataDir = dusk::data::configured_data_path();
+    if (dataDir.empty()) {
+        return path;
+    }
+    const std::filesystem::path dest = dataDir / src.filename();
+    if (src == dest || src.parent_path() == dataDir) {
+        return path;  // already inside persistent storage
+    }
+    std::filesystem::create_directories(dataDir, ec);
+    ec.clear();
+    std::filesystem::remove(dest, ec);  // replace any previously-stored disc
+    ec.clear();
+    std::filesystem::rename(src, dest, ec);
+    if (ec) {
+        // Different volume (or rename unsupported): copy, then drop the source.
+        ec.clear();
+        std::filesystem::copy_file(
+            src, dest, std::filesystem::copy_options::overwrite_existing, ec);
+        if (!ec) {
+            std::error_code rmEc;
+            std::filesystem::remove(src, rmEc);
+        }
+    }
+    if (ec) {
+        PrelaunchLog.warn(
+            "Could not relocate disc into persistent storage ({}); keeping picked path: {}",
+            ec.message(), path);
+        return path;
+    }
+    PrelaunchLog.info("Relocated selected disc into persistent storage: {}", dest.string());
+    return dest.string();
+#else
+    return path;
+#endif
+}
+
 void apply_valid_disc_result(
     const std::string& path, const iso::DiscInfo& info, iso::ValidationError validation) {
+    const std::string effectivePath = relocate_disc_to_persistent(path);
     auto& state = prelaunch_state();
-    state.configuredDiscPath = path;
+    state.configuredDiscPath = effectivePath;
     state.configuredDiscCanLaunch = true;
     state.configuredDiscInfo = info;
     state.configuredDiscValidation = validation;
-    if (state.activeDiscPath.empty() || path == state.activeDiscPath) {
-        state.activeDiscPath = path;
+    if (state.activeDiscPath.empty() || effectivePath == state.activeDiscPath) {
+        state.activeDiscPath = effectivePath;
         state.activeDiscInfo = info;
     }
-    persist_disc_choice(path, validation);
+    persist_disc_choice(effectivePath, validation);
 }
 
